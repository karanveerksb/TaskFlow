{
  "name": "taskflow",
  "private": true,
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "pnpm build && turbo test",
    "db:generate": "pnpm --filter @taskflow/db db:generate",
    "db:migrate": "pnpm --filter @taskflow/db db:migrate",
    "db:deploy": "pnpm --filter @taskflow/db db:deploy"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.9.3"
  },
  "engines": { "node": ">=22" }
}
